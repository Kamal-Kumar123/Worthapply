# =============================================================
# WorthApply — Environment Configuration
# =============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================

# --- LLM Provider ---
# Development: "local" (Ollama, free, no API quota)
# Deployment:  "xai"   (cloud API)
LLM_PROVIDER=local

# --- Cloud Configuration (deployment only) ---
XAI_API_KEY=
XAI_MODEL=grok-3-mini-fast
XAI_BASE_URL=https://api.x.ai/v1

# --- Local Provider (Ollama) — use during development ---
# Create with: ollama create worthapply-dev -f Modelfile.worthapply
LOCAL_MODEL=worthapply-dev
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_NUM_CTX=2048

# --- Web Search (optional, for company verification agent) ---
# SERPER_API_KEY=

# --- Application ---
# LOG_LEVEL=INFO
# TRACE_DIR=traces
# CASE_PAUSE_SECONDS=1
